diff --git a/ggml/src/ggml-sycl/fwht_blocked.cpp b/ggml/src/ggml-sycl/fwht_blocked.cpp
new file mode 100644
index 0000000..dabc498
--- /dev/null
+++ b/ggml/src/ggml-sycl/fwht_blocked.cpp
@@ -0,0 +1,177 @@
+#include "fwht_blocked.hpp"
+
+#include <cmath>
+
+namespace ggml {
+
+// One sub-group per (row, block). M is the INNER transform size, M = block/2.
+//
+// The two halves are processed in sequence through a compile-time-unrolled
+// loop, so only M/WARP_SIZE registers are live at once -- never block/WARP_SIZE.
+// `x` is therefore read twice, which is the deliberate cost of bounding the
+// register footprint (see the header).
+template <int M>
+static void fwht_blocked_kernel(const float * __restrict__ src,
+                                float * __restrict__ dst,
+                                const int8_t * __restrict__ signs,
+                                const int64_t n_units,   // nrows * nblocks
+                                const float scale,
+                                const sycl::nd_item<2> & item) {
+    static_assert(M % WARP_SIZE == 0, "inner size must be a whole number of sub-group widths");
+
+    const sycl::sub_group sg = item.get_sub_group();
+    const int lane = sg.get_local_linear_id();
+
+    const int64_t unit = item.get_global_id(0);   // one (row, block) per sub-group
+    if (unit >= n_units) {
+        return;
+    }
+
+    constexpr int el_w = M / WARP_SIZE;
+
+    const float * xb = src + unit * (2 * M);
+    float       * yb = dst + unit * (2 * M);
+    const int8_t * sb = signs + unit * (2 * M);
+
+    float reg[el_w];
+
+    // half == 0 -> lo = H.M (x_lo + x_hi) -> dst[0..M)
+    // half == 1 -> hi = H.M (x_lo - x_hi) -> dst[M..2M)
+#pragma unroll
+    for (int half = 0; half < 2; half++) {
+        const float sgn = half == 0 ? 1.0f : -1.0f;
+
+#pragma unroll
+        for (int j = 0; j < el_w; ++j) {
+            const int i = j * WARP_SIZE + lane;
+            // Multiplying by +-1 is a sign-bit flip; the compiler emits a cheap
+            // conditional negate for `* (float)sb[i]`, not a general multiply.
+            const float a = xb[i]              * (float) sb[i];
+            const float c = xb[i + M]          * (float) sb[i + M];
+            reg[j] = a + sgn * c;
+        }
+
+        // Stage 1: butterflies INSIDE the sub-group. These exchange values
+        // between lanes, so they need the sub-group permute -- without this half
+        // of the network the transform is incomplete and the result is wrong by
+        // O(1), not by rounding. (Omitting it was a real bug here: it produced
+        // |d| = 20.4 against the CPU reference while a pre-sized-reference bug
+        // in the test was hiding it.)
+#pragma unroll
+        for (int h = 1; h < WARP_SIZE; h *= 2) {
+#pragma unroll
+            for (int j = 0; j < el_w; ++j) {
+                const float val  = reg[j];
+                const float val2 = dpct::permute_sub_group_by_xor(sg, val, h, WARP_SIZE);
+                reg[j] = (lane & h) == 0 ? val + val2 : val2 - val;
+            }
+        }
+
+        // Stage 2: butterflies ACROSS registers.
+#pragma unroll
+        for (int h = WARP_SIZE; h < M; h *= 2) {
+            const int step = h / WARP_SIZE;
+#pragma unroll
+            for (int j = 0; j < el_w; j += 2 * step) {
+#pragma unroll
+                for (int k = 0; k < step; ++k) {
+                    const float x = reg[j + k];
+                    const float y = reg[j + k + step];
+                    reg[j + k]        = x + y;
+                    reg[j + k + step] = x - y;
+                }
+            }
+        }
+
+#pragma unroll
+        for (int j = 0; j < el_w; ++j) {
+            yb[half * M + j * WARP_SIZE + lane] = reg[j] * scale;
+        }
+    }
+}
+
+template <int M>
+static void launch_fwht_blocked(
+                                const float * src, float * dst,
+                                const int8_t * signs,
+                                const int64_t n_units,
+                                const float scale,
+                                dpct::queue_ptr stream) {
+    constexpr int rows_per_block = 4;
+
+    const int64_t num_blocks = (n_units + rows_per_block - 1) / rows_per_block;
+
+    const sycl::range<2> global(num_blocks * rows_per_block, WARP_SIZE);
+    const sycl::range<2> local(rows_per_block, WARP_SIZE);
+
+    stream->parallel_for(sycl::nd_range<2>(global, local),
+                         [=](sycl::nd_item<2> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                             fwht_blocked_kernel<M>(src, dst, signs, n_units, scale, item);
+                         });
+}
+
+bool sycl_fwht_blocked(sycl::queue & q,
+                       const float * src, float * dst,
+                       const int8_t * signs,
+                       int64_t nrows, int nblocks, int block) {
+    if (block <= 0 || nblocks <= 0 || nrows <= 0) {
+        return false;
+    }
+    // A Sylvester WHT is only defined for a power-of-two length. block must be
+    // one; the TOTAL width deliberately need not be, which is the whole point.
+    if ((block & (block - 1)) != 0) {
+        return false;
+    }
+    if (block < 2 * WARP_SIZE) {
+        return false;
+    }
+
+    const int      m    = block / 2;
+    const float    scale = 1.0f / std::sqrt((float) block);
+    const int64_t  n_units = nrows * (int64_t) nblocks;
+    dpct::queue_ptr stream = &q;
+
+    switch (m) {
+        // The inner size is what actually gets compiled, so dispatch here.
+        // 512 is the case Ternary-Bonsai needs (block 1024) and the one the
+        // existing production path already exercises; the smaller ones make the
+        // kernel testable at shapes the CPU oracle can also compute directly.
+        case 512:  launch_fwht_blocked<512>(src, dst, signs, n_units, scale, stream); return true;
+        case 256:  launch_fwht_blocked<256>(src, dst, signs, n_units, scale, stream); return true;
+        case 128:  launch_fwht_blocked<128>(src, dst, signs, n_units, scale, stream); return true;
+        case 64:   launch_fwht_blocked<64>(src, dst, signs, n_units, scale, stream);  return true;
+        case 32:   launch_fwht_blocked<32>(src, dst, signs, n_units, scale, stream);  return true;
+        case 16:   launch_fwht_blocked<16>(src, dst, signs, n_units, scale, stream);  return true;
+        default:
+            // Explicitly refusing is the whole point. Returning true here, or
+            // falling through to a plain mat-mul, is the silent-wrong-answer bug.
+            return false;
+    }
+}
+
+} // namespace ggml
+
+#ifndef FWHT_BLOCKED_NO_GGML_WRAPPER
+bool ggml_sycl_op_fwht_blocked(ggml_backend_sycl_context & ctx,
+                               const ggml_tensor * src, ggml_tensor * dst,
+                               int nblocks, const int8_t * signs) {
+    if (src->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_are_same_shape(src, dst)) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src) || !ggml_is_contiguous(dst)) {
+        return false;
+    }
+    if (signs == nullptr) {
+        return false;
+    }
+    const int block = (int) src->ne[0];
+    if (block <= 0 || block % nblocks != 0) {
+        return false;
+    }
+    return ggml::sycl_fwht_blocked(*ctx.stream(), (const float *) src->data, (float *) dst->data,
+                                   signs, ggml_nrows(src), nblocks, block);
+}
+#endif // FWHT_BLOCKED_NO_GGML_WRAPPER
diff --git a/ggml/src/ggml-sycl/fwht_blocked.hpp b/ggml/src/ggml-sycl/fwht_blocked.hpp
new file mode 100644
index 0000000..93cd154
--- /dev/null
+++ b/ggml/src/ggml-sycl/fwht_blocked.hpp
@@ -0,0 +1,62 @@
+#ifndef GGML_SYCL_FWHT_BLOCKED_HPP
+#define GGML_SYCL_FWHT_BLOCKED_HPP
+
+#include "common.hpp"
+
+// Blockwise SIGNED normalised Sylvester Walsh-Hadamard, for ternary weights
+// whose stored form is pre-rotated by H.D (D a random +-1 diagonal supplied in
+// GGUF metadata). See SIMULATION-PLAN.md 4.1.1 and R0.7.1/R0.7.3.
+//
+//     y[b] = (1/sqrt(BLOCK)) * H_BLOCK * (signs[b] .* x[b])   for each block b
+//
+// Why this is separate from ggml_sycl_op_fwht (fwht.hpp), which it complements
+// rather than replaces:
+//
+//   * fwht() serves KV-cache rotation. Its n is a head dimension -- a power of
+//     two, 64..512 -- and it transforms the WHOLE row in one N-wide butterfly.
+//   * This serves weight dequant. Its n is the *input width* of a weight
+//     (5120 / 6144 / 17408 for Ternary-Bonsai-2-27B), which is NOT a power of
+//     two, so a single N-wide WHT is not even defined. The model therefore
+//     declares a block size (1024) and the transform is BLOCKWISE, at one
+//     sign vector per block.
+//
+// Conflating the two is the mistake that would produce a plausible wrong
+// answer: fwht()'s `default: return false` is documented as "fall through to
+// the ordinary mat-mul", so a width it cannot serve is silently not applied.
+//
+// Register pressure. fwht_kernel<N> holds N/WARP_SIZE floats per lane. On this
+// build WARP_SIZE is 16 (GGML_SYCL_TARGET=INTEL), so a whole 1024 block would
+// be 64 registers per lane and spill. H.1024 = H.512 (x) H.2, so each 1024
+// block is done as two independent 512 transforms:
+//
+//     y_lo = H.512 (x_lo + x_hi)      y_hi = H.512 (x_lo - x_hi)
+//
+// which peaks at 512/16 = 32 registers per lane -- the same figure the
+// existing, production 512 path already uses. x is read twice; that is the
+// trade, and it is the same trade the register analysis predicted.
+
+namespace ggml {
+
+// Core, free of any ggml context so it can be unit-tested against a CPU
+// reference with a plain sycl::queue. `block` must be a power of two and
+// `nrows * nblocks * block` elements are processed, one independent transform
+// per (row, block). Returns false if the request is not one this can serve.
+bool sycl_fwht_blocked(sycl::queue & q,
+                       const float * src, float * dst,
+                       const int8_t * signs,
+                       int64_t nrows, int nblocks, int block);
+
+} // namespace ggml
+
+// The ggml-facing wrapper below is a thin adapter that resolves the stream from
+// the backend context and does the shape/contiguity guards. It is compiled out
+// for the standalone test (which defines FWHT_BLOCKED_NO_GGML_WRAPPER) so the
+// kernel can be proved against a CPU reference without linking all of libggml.
+// The part worth testing is the core, not the adapter.
+#ifndef FWHT_BLOCKED_NO_GGML_WRAPPER
+bool ggml_sycl_op_fwht_blocked(ggml_backend_sycl_context & ctx,
+                               const ggml_tensor * src, ggml_tensor * dst,
+                               int nblocks, const int8_t * signs);
+#endif
+
+#endif // GGML_SYCL_FWHT_BLOCKED_HPP
diff --git a/tests/test-fwht-blocked/test-fwht-blocked.cpp b/tests/test-fwht-blocked/test-fwht-blocked.cpp
new file mode 100644
index 0000000..1142f15
--- /dev/null
+++ b/tests/test-fwht-blocked/test-fwht-blocked.cpp
@@ -0,0 +1,220 @@
+// Standalone validation of the blockwise signed Hadamard SYCL kernel against a
+// CPU reference. Deliberately does NOT go through llama-server: the failure this
+// guards against is silent (a transform that is simply not applied), so the
+// kernel has to be provable on its own before it is wired into a dispatch.
+//
+// The CPU reference is the STRAIGHTFORWARD blocked form; the kernel uses the
+// Kronecker form (two 512 halves). Their agreement is what validates the
+// register-saving decomposition on real hardware, not just on paper.
+//
+// Optionally takes a file of +1/-1 integers to use as the sign vector, so the
+// real Ternary-Bonsai sign block can be replayed:
+//     ./test-fwht-blocked <signs-file> <block> <nblocks> <nrows>
+
+#include "fwht_blocked.hpp"
+
+#include <sycl/sycl.hpp>
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+static int g_fail = 0, g_checks = 0;
+static void check(bool ok, const char *what, double d = 0.0) {
+    g_checks++;
+    if (ok) printf("PASS  %s  (worst |d|=%.3g)\n", what, d);
+    else    { g_fail++; printf("FAIL  %s  (worst |d|=%.3g)\n", what, d); }
+}
+
+static uint32_t lcg(uint32_t *s) { *s = *s * 1664525u + 1013904223u; return *s; }
+
+// CPU reference: per block, sign-multiply then a full in-place FWHT, normalised.
+static void ref_blocked(const std::vector<float> & x, std::vector<float> & y,
+                        const std::vector<int8_t> & s, int nrows, int nblocks, int block) {
+    // Refuse rather than write out of bounds: a short destination is exactly the
+    // bug that made this file lie for an hour.
+    if ((int) x.size() < nrows * nblocks * block || (int) y.size() < nrows * nblocks * block ||
+        (int) s.size() < nrows * nblocks * block) {
+        fprintf(stderr, "ref_blocked: size mismatch\n");
+        exit(2);
+    }
+    const float scale = (float)(1.0 / std::sqrt((double) block));
+    for (int r = 0; r < nrows; r++) {
+        for (int b = 0; b < nblocks; b++) {
+            const size_t base = (size_t)r * nblocks * block + (size_t)b * block;
+            std::vector<float> t(block);
+            for (int i = 0; i < block; i++) t[i] = x[base + i] * (float) s[base + i];
+            for (int h = 1; h < block; h *= 2)
+                for (int i = 0; i < block; i += 2 * h)
+                    for (int j = i; j < i + h; j++) {
+                        const float u = t[j], v = t[j + h];
+                        t[j] = u + v; t[j + h] = u - v;
+                    }
+            for (int i = 0; i < block; i++) y[base + i] = t[i] * scale;
+        }
+    }
+}
+
+static bool read_signs(const char *path, std::vector<int8_t> & out, size_t want) {
+    FILE * f = fopen(path, "r");
+    if (!f) return false;
+    // clear() is load-bearing. Without it a pre-sized caller's vector makes
+    // `out.size() < want` false on entry, the loop never runs, the function
+    // returns TRUE having read nothing, and the caller believes it has the real
+    // signs. That is not hypothetical: it happened, and the parity check passed
+    // vacuously on an all-zero sign vector until the checksum was compared
+    // against an independent one.
+    out.clear();
+    long v = 0;
+    while ((size_t)out.size() < want) {
+        if (fscanf(f, "%ld", &v) != 1) break;
+        out.push_back((int8_t)(v > 0 ? 1 : -1));
+    }
+    fclose(f);
+    return out.size() == want;
+}
+
+int main(int argc, char ** argv) {
+    int  block   = 1024, nblocks = 5, nrows = 7;
+    const char * signs_path = nullptr;
+    if (argc >= 5) {
+        signs_path = argv[1]; block = atoi(argv[2]); nblocks = atoi(argv[3]); nrows = atoi(argv[4]);
+    } else if (argc >= 2) {
+        signs_path = argv[1];
+    }
+
+    sycl::queue q;
+    printf("=== test-fwht-blocked ===\n");
+    printf("  device: %s\n", q.get_device().get_info<sycl::info::device::name>().c_str());
+    {
+        const auto sgs = q.get_device().get_info<sycl::info::device::sub_group_sizes>();
+        printf("  sub-group sizes supported: %u ->", (unsigned) sgs.size());
+        for (auto v : sgs) printf(" %u", (unsigned) v);
+        printf("\n");
+    }
+    printf("  block=%d nblocks=%d nrows=%d total=%d\n", block, nblocks, nrows, block * nblocks * nrows);
+
+    const int n = block * nblocks * nrows;
+
+    std::vector<int8_t> signs((size_t)n, 0);
+    bool from_file = false;
+    if (signs_path && read_signs(signs_path, signs, (size_t)n)) {
+        from_file = true;
+        printf("  signs: %d values read from %s\n", n, signs_path);
+    } else {
+        if (signs_path) {
+            printf("  signs: COULD NOT READ %d values from %s -- falling back to synthetic\n",
+                   n, signs_path);
+        }
+        uint32_t s = 0x9E3779B9u;
+        for (int i = 0; i < n; i++) signs[(size_t)i] = (lcg(&s) & 1u) ? (int8_t) 1 : (int8_t) -1;
+    }
+    {
+        // checksum + head/tail, so "which signs ran" is answerable from outside
+        uint32_t h = 2166136261u; int pos = 0, neg = 0;
+        for (int i = 0; i < n; i++) {
+            h = (h ^ (uint32_t)(int)(signs[(size_t)i] + 1)) * 16777619u;
+            if (signs[(size_t)i] > 0) pos++; else neg++;
+        }
+        printf("  signs: source=%s first=%d last=%d  +1:%d -1:%d  fnv1a=%08x\n",
+               from_file ? "FILE" : "SYNTHETIC", (int) signs[0], (int) signs[(size_t)n - 1],
+               pos, neg, h);
+    }
+
+    // A degenerate sign vector would make the parity comparison below trivially
+    // true (both sides produce zero), so it is asserted rather than assumed.
+    {
+        int pos = 0, neg = 0;
+        for (int i = 0; i < n; i++) (signs[(size_t)i] > 0 ? pos : neg)++;
+        check(pos > 0 && neg > 0, "sign vector is non-degenerate (has BOTH +1 and -1)");
+    }
+
+    std::vector<float> x((size_t)n), y((size_t)n, 0.0f);
+    uint32_t s2 = 12345u;
+    for (int i = 0; i < n; i++) x[(size_t)i] = (float)((double)((int)(lcg(&s2) % 2001) - 1000) / 1000.0);
+
+    // SIZED. Declaring this empty and then writing y[base+i] into it is
+    // out-of-bounds, and the resulting undefined behaviour made the headline
+    // parity check compare the kernel against junk: it passed on a correct
+    // kernel and MISSED three of four injected faults. The check that did catch
+    // a fault was the only one not of the form kernel-vs-reference. Every
+    // reference buffer in this file is sized explicitly for that reason.
+    std::vector<float> ref((size_t)n, 0.0f);
+    ref_blocked(x, ref, signs, nrows, nblocks, block);
+
+    bool served = ggml::sycl_fwht_blocked(q, x.data(), y.data(), signs.data(), nrows, nblocks, block);
+    check(served, "kernel accepted the request (did not silently refuse)");
+    if (!served) { printf("  cannot continue\n"); return 1; }
+    q.wait_and_throw();
+
+    double worst = 0.0; int worst_i = -1;
+    for (int i = 0; i < n; i++) {
+        const double d = std::fabs((double) y[(size_t)i] - (double) ref[(size_t)i]);
+        if (d > worst) { worst = d; worst_i = i; }
+    }
+    // float32 accumulate over `block` terms; 1e-4 is generous but still ~4
+    // orders of magnitude below what any real fault produces.
+    check(worst < 1e-4, "SYCL Kronecker form matches the CPU blocked reference", worst);
+    if (worst >= 1e-4 && worst_i >= 0) printf("      worst at i=%d  got %.9g want %.9g\n",
+                                               worst_i, y[(size_t)worst_i], ref[(size_t)worst_i]);
+
+    // Bisection: with an all-+1 sign vector the kernel reduces to the plain
+    // normalised H_1024, so this isolates {halves, butterfly, layout} from the
+    // sign path. If this passes and the signed one fails, the bug is in how the
+    // signs are applied; if it fails too, the bug is structural.
+    {
+        std::vector<int8_t> allpos((size_t)n, 1);
+        std::vector<float> ry((size_t)n, 0.0f), rref((size_t)n, 0.0f);
+        ref_blocked(x, rref, allpos, nrows, nblocks, block);
+        bool ok = ggml::sycl_fwht_blocked(q, x.data(), ry.data(), allpos.data(), nrows, nblocks, block);
+        q.wait_and_throw();
+        double w2 = 0.0;
+        for (int i = 0; i < n; i++) w2 = std::max(w2, std::fabs((double) ry[(size_t)i] - (double) rref[(size_t)i]));
+        check(ok && w2 < 1e-4, "UNSIGNED parity (isolates halves/butterfly from signs)", w2);
+        if (!(w2 < 1e-4)) {
+            printf("      (unsigned worst at i=0: got %.9g want %.9g)\n",
+                   (double) ry[0], (double) rref[0]);
+        }
+    }
+
+    // And nblocks=1: a single 1024 block, so the half-split is the only thing
+    // under test with no repetition to average over.
+    {
+        const int nb1 = 1;
+        std::vector<float> y1((size_t)block * nrows, 0.0f);
+        std::vector<float> r1((size_t)block * nrows, 0.0f);
+        std::vector<int8_t> s1(signs.begin(), signs.begin() + block * nrows);
+        ref_blocked(x, r1, s1, nrows, nb1, block);
+        bool ok = ggml::sycl_fwht_blocked(q, x.data(), y1.data(), s1.data(), nrows, nb1, block);
+        q.wait_and_throw();
+        double w3 = 0.0;
+        for (int i = 0; i < block * nrows; i++)
+            w3 = std::max(w3, std::fabs((double) y1[(size_t)i] - (double) r1[(size_t)i]));
+        check(ok && w3 < 1e-4, "single-block parity (nblocks=1)", w3);
+    }
+
+    // The omission test: without the signs the answer must differ materially.
+    std::vector<int8_t> ones((size_t)n, 1);
+    std::vector<float> y2((size_t)n, 0.0f);
+    bool ok2 = ggml::sycl_fwht_blocked(q, x.data(), y2.data(), ones.data(), nrows, nblocks, block);
+    q.wait_and_throw();
+    if (ok2) {
+        double dworst = 0.0;
+        for (int i = 0; i < n; i++) {
+            const double d = std::fabs((double) y[(size_t)i] - (double) y2[(size_t)i]);
+            if (d > dworst) dworst = d;
+        }
+        check(dworst > 1.0, "dropping the sign vector changes the on-device result", dworst);
+    }
+
+    // Non-power-of-two block must be REFUSED, never quietly wrong.
+    check(!ggml::sycl_fwht_blocked(q, x.data(), y.data(), signs.data(), nrows, nblocks, 1000),
+          "a non-power-of-two block is refused rather than silently mishandled");
+
+    printf("--- %d checks, %d failures ---\n", g_checks, g_fail);
+    printf(g_fail ? "FWHT_BLOCKED_TEST_FAIL\n" : "FWHT_BLOCKED_TEST_PASS\n");
+    return g_fail ? 1 : 0;
+}
